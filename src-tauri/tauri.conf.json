{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dropilot",
  "version": "0.2.0",
  "identifier": "io.dropilot.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://static-cdn.jtvnw.net https://*.jtvnw.net https://files.kick.com https://*.kick.com https://*.epicgames.com; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost https://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "publisher": "Dropilot Contributors",
    "copyright": "Copyright (c) 2026 Dropilot Contributors",
    "category": "Utility",
    "shortDescription": "Automatic Twitch and Kick Drops farmer",
    "longDescription": "Dropilot is a lightweight, privacy-focused Windows desktop app that automatically tracks and farms Twitch Drops and Kick Drops for your own logged-in accounts.",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAzNkUwMEI3MTUxQjM0QTYKUldTbU5Cc1Z0d0J1QXlINmVsUm9GamhNZU13cHM5bEJCMW12TTZ6SWlhb2tnWEtCWXdBZ2JRaFEK",
      "endpoints": [
        "https://github.com/theflash1211/dropilot/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
